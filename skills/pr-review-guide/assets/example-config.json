            {"from": "attempting", "to": "failed", "event": "rejects on last attempt"}
          ]
        },
        "caption": "The Waiting state is new: before, a rejection went straight back to Attempting."
      }],
      "changes": {
        "added": [
          {"impact": "High", "text": "<code>withRetry</code> runs <code>fn</code> up to <code>attempts</code> times. It sleeps <code>backoffDelay</code> between attempts and rethrows the last error."},
